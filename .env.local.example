# Supabase — copie este arquivo para .env.local e preencha com os valores
# do seu projeto (Project Settings → API no painel do Supabase).
# Essas chaves são seguras de expor no client; a proteção real dos dados
# é a Row Level Security (RLS) configurada no banco.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preview (opcionais; ver docs/plano-v1.md B3/B4)
# NEXT_PUBLIC_MOCKUPS=1   # só em branch deploy/preview: liga mockups e devolve 404 em /admin e /login
# SITE_INDEXAVEL=1        # só em produção no go-live: remove o noindex. Build falha se junto com MOCKUPS
# SITE_URL=https://simplicitude.com.br   # endereço público (og:image absoluta); sem ela usa o do preview Netlify
